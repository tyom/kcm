#!/usr/bin/env bash
# kcm: Keychain Master - Secret management utility for macOS Keychain
# Version: 0.5.0
#
# Run 'kcm help' for usage information

set -euo pipefail

_KCM_VERSION="0.5.0"
_KCM_SCRIPT_NAME="$(basename "$0")"

# Colors for output
_KCM_RED='\033[0;31m'
_KCM_GREEN='\033[0;32m'
_KCM_YELLOW='\033[1;33m'
_KCM_BLUE='\033[0;34m'
_KCM_GREY='\033[90m'
_KCM_NC='\033[0m' # No Color

# Arrays holding processed env assignments (stay in memory)
declare -a _KCM_PROCESSED_ENV_NAMES=()
declare -a _KCM_PROCESSED_ENV_VALUES=()
# start:end line numbers of each assignment (end differs for multiline values)
declare -a _KCM_PROCESSED_ENV_LINES=()

# Helper functions
error_exit() {
  echo -e "${_KCM_RED}Error: $1${_KCM_NC}" >&2
  exit 1
}

success() {
  echo -e "${_KCM_GREEN}✓${_KCM_NC} $1" >&2
}

info() {
  echo -e "${_KCM_YELLOW}ℹ${_KCM_NC} $1" >&2
}

show_help() {
  cat << EOF
kcm - Keychain Master

USAGE:
  $_KCM_SCRIPT_NAME <command> [options]

COMMANDS:
  add KEY_NAME [-] [-c COMMENT]
    Add a secret to Keychain and output the .env entry

    Options:
      KEY_NAME          - Interactive mode (prompts for value)
      KEY_NAME -        - Read value from stdin
      -c, --comment COMMENT - A hint shown by ls and in Keychain Access (up to 200
                              characters, stored unencrypted). Kept when you add
                              the name again without -c.

    Examples:
      kcm add API_KEY      # Prompts for value
      echo "secret" | kcm add TOKEN -
      cat ~/secret.txt | kcm add AWS_KEY -
      kcm add STRIPE_KEY -c "Test mode key, from the Stripe dashboard"
      kcm show API_KEY | kcm add API_KEY - -c "What it is for"  # Hint for an existing secret

  remove KEY_NAME
    Remove a secret from Keychain

    Example:
      kcm remove OLD_API_KEY

  show KEY_NAME
    Display the value of a secret from Keychain

    Example:
      kcm show DATABASE_URL

  copy KEY_NAME
    Copy a secret value to clipboard (auto-clears after 45 seconds)

    Example:
      kcm copy API_KEY

  ls [pattern]
    List kcm's secrets in Keychain matching pattern (supports wildcards).
    Shows the comment given with 'add -c' next to each name.
    Other apps' entries are hidden. Untagged entries that look like ones an
    older kcm added (your account, a valid key name) are listed separately.

    Examples:
      kcm ls               # List all kcm secrets
      kcm ls 'DATABASE*'   # List secrets starting with DATABASE
      kcm ls '*_KEY'       # List secrets ending with _KEY

  use [options] [-- COMMAND [ARGS...]]
    Run a command with secrets from .env files resolved.
    Without a command, list the variables that would be loaded and their source file.

    Without --env-file, kcm loads .env, .env.local, .env.<mode> and .env.<mode>.local
    from the current folder up to the git root and merges them. The closest folder wins,
    and within a folder the order is .env < .env.<mode> < .env.local < .env.<mode>.local.
    <mode> is \$NODE_ENV (default: development).
    Variables already set in the environment win over env files.

    Options:
      -e, --env-file FILE   - Use only this env file (skips discovery)
      -s, --show-values     - Without a command, show masked values (first and last 4 chars)
      --full                - Without a command, show full values (opens in less so they stay
                              out of terminal scrollback; prints plain text when piped)

    Examples:
      kcm use              # list variable names and where they come from
      kcm use -s           # check values, masked
      kcm use --full       # inspect full values in a pager
      kcm use -- npm run dev
      NODE_ENV=production kcm use -- node server.js
      kcm use -e .env -- npm run dev
      kcm use --env-file ../.env -- make run-server
      kcm use -e .env -- echo \$DATABASE_URL

  import [-e FILE]
    Move plain values from .env files into Keychain and replace them with
    keychain:// references. Lists the values (masked) with likely secrets
    ticked: up/down to move, space to toggle, a for all, Enter to continue.
    Then asks how to handle names already in Keychain, and confirms.
    Without -e, scans every .env and .env.* file from the current folder up
    to the git root (*.example, *.sample and *.template are skipped).

    Options:
      -e, --env-file FILE   - Only import from this file

    Examples:
      kcm import
      kcm import -e .env.local

  export [-e FILE] [-o FILE | -c]
    Resolve env files like 'use' and write plain NAME='value' lines, for example
    to share them with someone. Fails if a keychain:// entry is missing.
    Without -o or -c, opens in less in a terminal (kept out of scrollback)
    and prints plain text when piped.

    Options:
      -e, --env-file FILE   - Use only this env file (skips discovery)
      -o, --output FILE     - Write to a new file, readable only by you
      -c, --copy            - Copy to clipboard (auto-clears after 45 seconds)

    Examples:
      kcm export -c
      kcm export -o shared.env
      kcm export -e .env.local | pbcopy

  install-wrapper [PATH]
    Add a script to the current git repo that runs a command through 'kcm use'
    when kcm is installed, and runs it directly otherwise. Use it in committed
    scripts so teammates without kcm can run them with plain .env values.
    Without PATH, asks for the location (default: scripts/with-env).

    Examples:
      kcm install-wrapper
      kcm install-wrapper bin/with-env

  help
    Show this help message

ENVIRONMENT VARIABLE FORMAT:
  keychain://LABEL - Retrieved from macOS Keychain

  If a secret is missing or unreadable, kcm warns and keeps the original value.
  If the name matches several Keychain entries ambiguously, kcm stops.

EOF
}

# Function to add secret to keychain
add_secret() {
  # Check if running on macOS
  if ! command -v security >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'security' command"
  fi

  local KEY_NAME="" SECRET_VALUE="" from_stdin=false hint=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|--comment)
        [ -n "${2:-}" ] || error_exit "-c/--comment requires an argument"
        hint="$2"
        shift 2
        ;;
      -)
        from_stdin=true
        shift
        ;;
      *)
        [ -z "$KEY_NAME" ] || error_exit "Inline values are not supported. Use interactive input or pipe via '-'"
        KEY_NAME="$1"
        shift
        ;;
    esac
  done

  if [ -z "$KEY_NAME" ]; then
    echo -e "${_KCM_RED}Error: KEY_NAME is required${_KCM_NC}" >&2
    echo "" >&2
    echo "Usage: $_KCM_SCRIPT_NAME add KEY_NAME [-] [-c COMMENT]" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  $_KCM_SCRIPT_NAME add API_KEY                    # Interactive" >&2
    echo "  echo \"secret\" | $_KCM_SCRIPT_NAME add TOKEN -   # From stdin" >&2
    exit 1
  fi

  # security -i takes about 4 KB per line: a long comment would push the value onto the argument list
  if [ ${#hint} -gt 200 ]; then
    error_exit "Comment is ${#hint} characters, the limit is 200"
  fi
  # ls and the next add tell kcm's own comments from a hint by this wording
  if [[ "$hint" == "Added by kcm" || "$hint" == "Imported by kcm"* ]]; then
    error_exit "A comment can't be 'Added by kcm' or start with 'Imported by kcm': kcm uses that wording for its own comments"
  fi

  # Validate key name (alphanumeric and underscore only)
  if ! [[ "$KEY_NAME" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]]; then
    error_exit "Key name must start with a letter and contain only letters, numbers, and underscores"
  fi

  # Get the secret value
  if [ "$from_stdin" = false ]; then
    # Interactive mode - prompt for value
    info "Enter secret value for $KEY_NAME (input will be hidden):"
    echo -e "${_KCM_GREY}For long secrets (>1000 chars), use: ${_KCM_GREEN}pbpaste | $_KCM_SCRIPT_NAME add $KEY_NAME -${_KCM_NC}" >&2
    IFS= read -rs SECRET_VALUE
    echo "" >&2  # New line after hidden input

    if [ -z "$SECRET_VALUE" ]; then
      error_exit "Secret value cannot be empty"
    fi
  else
    # Strip only the one newline echo or show adds; the x keeps any others
    SECRET_VALUE=$(cat; printf x)
    SECRET_VALUE="${SECRET_VALUE%x}"
    SECRET_VALUE="${SECRET_VALUE%$'\n'}"

    if [ -z "$SECRET_VALUE" ]; then
      error_exit "No input received from stdin"
    fi
  fi

  if store_secret "$KEY_NAME" "$SECRET_VALUE" "" "$hint"; then
    success "Secret added to Keychain"

    # Output the .env line
    echo ""
    echo "# Add this line to your .env file:"
    echo "${KEY_NAME}=\"keychain://${KEY_NAME}\""

    # Also provide info about verification
    echo "" >&2
    info "To verify: security find-generic-password -s \"$KEY_NAME\" -w" >&2
    info "To use: $_KCM_SCRIPT_NAME use --env-file .env -- <command>" >&2
  else
    error_exit "Failed to add secret to Keychain"
  fi
}

# Quote a string for a security -i command line.
# security -i runs each line as a command, so newlines become spaces.
security_quote() {
  local s="${1//$'\n'/ }"
  s="${s//\\/\\\\}"
  printf '"%s"' "${s//\"/\\\"}"
}

# Byte length of a string. ${#s} counts characters in a UTF-8 locale, and security -i limits bytes.
byte_length() {
  printf '%s' "$1" | wc -c
}

# Store a secret, creating or updating it in place. COMMENT is kcm's own note; HINT is
# the user's and replaces any comment. Without HINT, an existing hint is kept.
# The value goes in as hex on stdin so it never shows in the process list.
# Kind "kcm secret" and creator "kcm " mark kcm's entries; these attributes are not encrypted.
store_secret() {
  local name="$1" value="$2" comment="${3:-Added by kcm}" hint="${4:-}" account hex cmd got old
  local update=() target=() status keychain_arg="" keep=false
  if select_keychain_item "$name"; then
    account="$_KCM_ITEM_ACCOUNT"
    target=("$_KCM_ITEM_KEYCHAIN")
    update=(-U)
    keychain_arg=" $(security_quote "$_KCM_ITEM_KEYCHAIN")"
    # A hint someone wrote outlives a new value; kcm's own comments are replaced.
    # Without a new hint, a failed lookup stops the write so it can't drop the old one.
    # A kept hint is left out of the update: security then leaves it as it is, newlines and all.
    if [ -z "$hint" ]; then
      old=$(item_comment "$name") || { [ "$?" -ne 2 ] || return 1; }
      if [ -n "$old" ] && [[ "$old" != "Added by kcm" && "$old" != "Imported by kcm"* ]]; then
        keep=true
      fi
    fi
  else
    status=$?
    [ "$status" -eq 44 ] || return 1
    account="$USER"
  fi
  if [ -n "$hint" ]; then comment="$hint"; fi
  # One line, as security -i needs, so the read-back below compares like with like
  comment="${comment//$'\n'/ }"
  hex=$(printf '%s' "$value" | xxd -p | tr -d '\n')
  local comment_args=() comment_cmd=""
  if [ "$keep" = false ]; then
    comment_args=(-j "$comment")
    comment_cmd=" -j $(security_quote "$comment")"
  fi
  cmd="add-generic-password ${update[*]-} -s \"$name\" -a $(security_quote "$account") -D \"kcm secret\" -c \"kcm \"$comment_cmd -X $hex$keychain_arg"
  # security -i silently truncates lines over 4095 bytes. Drop the source path before
  # giving up on stdin, so the metadata never pushes a value onto argv.
  if [ "$(byte_length "$cmd")" -ge 4096 ] && [ "$keep" = false ] && [ -z "$hint" ] && [[ "$comment" == "Imported by kcm from "* ]]; then
    comment="Imported by kcm"
    comment_args=(-j "$comment")
    cmd="add-generic-password ${update[*]-} -s \"$name\" -a $(security_quote "$account") -D \"kcm secret\" -c \"kcm \" -j $(security_quote "$comment") -X $hex$keychain_arg"
  fi
  if [ "$(byte_length "$cmd")" -lt 4096 ]; then
    printf '%s\n' "$cmd" | security -i >/dev/null 2>&1
  else
    # shortcut: security -i reads at most 4095 bytes per line, so values over ~2 KB still go through argv
    security add-generic-password ${update[@]+"${update[@]}"} -s "$name" -a "$account" -D "kcm secret" -c "kcm " ${comment_args[@]+"${comment_args[@]}"} \
      -X "$hex" ${target[@]+"${target[@]}"} >/dev/null 2>&1 || return 1
  fi
  # security -i exits 0 even when the command fails, so read the value back.
  # The x keeps trailing newlines that $(...) would strip.
  got=$(read_secret "$name" && printf x) || return 1
  [ "$got" = "${value}x" ] || return 1
  # The value alone can match after a failed write, as when only the hint changes
  [ "$keep" = true ] && return 0
  select_keychain_item "$name" || return 1
  [ "$(item_comment "$name")" = "$comment" ]
}

# Print a secret's value.
# -w prints hex once a value has a newline or other non-printable byte, so parse -g instead:
# it prints `password: "value"` or `password: 0x<hex>  "<escaped>"`.
read_secret() {
  local out
  select_keychain_item "$1" || return $?
  out=$(security find-generic-password -s "$1" -a "$_KCM_ITEM_ACCOUNT" -g "$_KCM_ITEM_KEYCHAIN" 2>&1 >/dev/null) || return 1
  decode_security_value "$(sed -n 's/^password: //p' <<< "$out")"
}

# Print a value as security shows it: "text", or 0x<hex>  "<escaped>" when it has
# a non-printable byte. Fails on anything else, such as <NULL>.
decode_security_value() {
  local out="$1"
  case "$out" in
    0x*) out="${out%% *}"; xxd -r -p <<< "${out#0x}" ;;
    \"*\") out="${out#\"}"; printf '%s' "${out%\"}" ;;
    *) return 1 ;;
  esac
}

# Print the comment of the item select_keychain_item chose. Attributes only, so no Keychain prompt.
# Returns 1 when the item has no comment and 2 when the lookup itself failed.
item_comment() {
  local out
  out=$(security find-generic-password -s "$1" -a "$_KCM_ITEM_ACCOUNT" "$_KCM_ITEM_KEYCHAIN" 2>/dev/null) || return 2
  decode_security_value "$(sed -n 's/^ *"icmt"<blob>=//p' <<< "$out")"
}

# Choose the same tagged or legacy entry as ls. An untagged entry under another account
# is used only when it is the sole entry with that name: another app's entry beside it
# could belong to the same app, so kcm refuses rather than guess. Status 44 means absent.
select_keychain_item() {
  local name="$1" matches rank account keychain best=0 count=0 total=0
  [ -n "$name" ] || return 44
  security find-generic-password -s "$name" >/dev/null 2>&1 || return $?
  matches=$(keychain_services '.*' "$name") || return 1
  while IFS=$'\t' read -r rank account keychain; do
    [ -n "$rank" ] || continue
    total=$((total + 1))
    if (( rank > best )); then
      best=$rank
      count=0
      _KCM_ITEM_ACCOUNT="${account#=}"
      _KCM_ITEM_KEYCHAIN="$keychain"
    fi
    if (( rank == best )); then count=$((count + 1)); fi
  done <<< "$matches"
  if (( count > 1 || (best == 1 && total > 1) )); then
    info "Keychain name '$name' is ambiguous. Give each matching entry a distinct service name."
    return 2
  fi
  if (( best == 0 )) || [ -z "$_KCM_ITEM_ACCOUNT" ] || [ -z "$_KCM_ITEM_KEYCHAIN" ]; then
    info "Cannot select a unique kcm or untagged Keychain item for '$name'"
    return 2
  fi
}

# Split TEXT at its closing quote Q: the first Q followed only by spaces or a # comment.
# On success sets _KCM_QUOTED_VALUE to the text before it.
find_closing_quote() {
  local rest="$1" q="$2"
  _KCM_QUOTED_VALUE=""
  while [[ "$rest" == *"$q"* ]]; do
    _KCM_QUOTED_VALUE+="${rest%%"$q"*}"
    rest="${rest#*"$q"}"
    [[ "$rest" =~ ^[[:space:]]*(#.*)?$ ]] && return 0
    _KCM_QUOTED_VALUE+="$q"
  done
  return 1
}

# True if NAME was exported to kcm by the caller (set _KCM_EXPORTED_NAMES first)
is_exported() {
  [[ "$_KCM_EXPORTED_NAMES" == *$'\n'"$1"$'\n'* ]]
}

# Record one assignment and its start:end lines
add_env_value() {
  _KCM_PROCESSED_ENV_NAMES+=("$1")
  _KCM_PROCESSED_ENV_VALUES+=("$2")
  _KCM_PROCESSED_ENV_LINES+=("$3")
}

# Parse an env file into _KCM_PROCESSED_ENV_NAMES and _KCM_PROCESSED_ENV_VALUES.
# Values are only ever exported, never passed to source or eval.
process_env_file() {
  local env_file="$1"
  _KCM_PROCESSED_ENV_NAMES=()
  _KCM_PROCESSED_ENV_VALUES=()
  _KCM_PROCESSED_ENV_LINES=()
  [ -f "$env_file" ] || return 0

  local line var_name="" var_value="" quote_char="" lineno=0 start=0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    lineno=$((lineno + 1))

    # Inside a multiline value, until a line with the closing quote
    if [ -n "$quote_char" ]; then
      if find_closing_quote "$line" "$quote_char"; then
        var_value+=$'\n'"$_KCM_QUOTED_VALUE"
        quote_char=""
        add_env_value "$var_name" "$var_value" "$start:$lineno"
      else
        var_value+=$'\n'"$line"
      fi
      continue
    fi

    case "$line" in '#'*|'') continue ;; esac
    [[ "$line" == *"="* ]] || continue

    var_name="${line%%=*}"
    var_name="${var_name#export }"
    var_value="${line#*=}"
    [[ "$var_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    start=$lineno

    case "$var_value" in
      \"*|\'*)
        quote_char="${var_value:0:1}"
        var_value="${var_value:1}"
        # No closing quote on this line: multiline value
        find_closing_quote "$var_value" "$quote_char" || continue
        var_value="$_KCM_QUOTED_VALUE"
        quote_char=""
        ;;
    esac
    add_env_value "$var_name" "$var_value" "$start:$lineno"
  done < "$env_file"
  if [ -n "$quote_char" ]; then
    error_exit "$env_file:$start: unclosed quote for $var_name"
  fi
}

# Print the git root: the nearest folder with .git (a file in worktrees), from the physical cwd
find_git_root() {
  local root
  root=$(pwd -P)
  while [ "$root" != "/" ] && [ ! -e "$root/.git" ]; do
    root="${root%/*}"; root="${root:-/}"
  done
  [ -e "$root/.git" ] || return 1
  printf '%s\n' "$root"
}

# Find env files from the current directory up to the git root.
# Within a folder: .env < .env.<mode> < .env.local < .env.<mode>.local.
# Across folders: the closest folder wins.
# Sets _KCM_ENV_FILES, lowest priority first.
discover_env_files() {
  local mode="${NODE_ENV:-development}"
  local names=(".env.$mode.local" ".env.local")
  # Mode "local" would list .env.local twice
  [ "$mode" = local ] || names+=(".env.$mode")
  names+=(".env")
  local found=()  # closest and highest priority first
  # Physical path: relative paths like ../.env resolve from it, not from a symlinked $PWD
  local dir rel="./" name root
  dir=$(pwd -P)
  # Without a git root, only check cwd
  root=$(find_git_root) || root="$dir"

  while :; do
    for name in "${names[@]}"; do
      [ -f "$dir/$name" ] && found+=("$rel$name")
    done
    [ "$dir" = "$root" ] && break
    dir="${dir%/*}"; dir="${dir:-/}"
    if [ "$rel" = "./" ]; then rel="../"; else rel="../$rel"; fi
  done

  if [ ${#found[@]} -eq 0 ]; then
    info "Warning: no .env files found, proceeding without them"
    return 0
  fi

  local list
  printf -v list '%s, ' "${found[@]}"
  info "Loaded ${list%, }"

  local i
  for (( i=${#found[@]}-1; i>=0; i-- )); do
    _KCM_ENV_FILES+=("${found[$i]}")
  done
}

# Parse _KCM_ENV_FILES in order; a later file overrides an earlier one, the environment wins.
# Keep references as text until the caller needs values.
merge_env_files() {
  _KCM_MERGED_NAMES=()
  _KCM_MERGED_VALUES=()
  _KCM_MERGED_SOURCES=()

  local file idx j k name
  for file in ${_KCM_ENV_FILES[@]+"${_KCM_ENV_FILES[@]}"}; do
    process_env_file "$file"
    for idx in "${!_KCM_PROCESSED_ENV_NAMES[@]}"; do
      name="${_KCM_PROCESSED_ENV_NAMES[$idx]}"
      j=${#_KCM_MERGED_NAMES[@]}
      for k in "${!_KCM_MERGED_NAMES[@]}"; do
        if [ "${_KCM_MERGED_NAMES[$k]}" = "$name" ]; then j=$k; break; fi
      done
      _KCM_MERGED_NAMES[j]="$name"
      _KCM_MERGED_VALUES[j]="${_KCM_PROCESSED_ENV_VALUES[$idx]}"
      _KCM_MERGED_SOURCES[j]="$file"
      if is_exported "$name"; then _KCM_MERGED_SOURCES[j]="environment"; fi
    done
  done
}

# Replace keychain:// references with their values. strict: fail on a missing entry.
resolve_env_values() {
  local k value strict="${1:-}"
  for k in "${!_KCM_MERGED_NAMES[@]}"; do
    value="${_KCM_MERGED_VALUES[$k]}"
    [[ "$value" == keychain://* ]] && ! is_exported "${_KCM_MERGED_NAMES[$k]}" || continue
    # The x keeps trailing newlines
    if value=$(read_secret "${value#keychain://}" && printf x) && [ "$value" != x ]; then
      _KCM_MERGED_VALUES[k]="${value%x}"
    elif [ "$?" -eq 2 ]; then
      error_exit "Cannot resolve ${_KCM_MERGED_VALUES[$k]} for ${_KCM_MERGED_NAMES[$k]}"
    elif [ "$strict" = strict ]; then
      error_exit "${_KCM_MERGED_VALUES[$k]} for ${_KCM_MERGED_NAMES[$k]} not found in Keychain"
    else
      info "Warning: ${_KCM_MERGED_VALUES[$k]} not found in Keychain, keeping it as is"
    fi
  done
}

# Print a value safe to show: from 24 chars the first and last 4 (at most a third of it), else ****
mask_value() {
  local value="$1"
  if [ ${#value} -ge 24 ]; then
    value="${value:0:4}…${value: -4}"
    printf '%s' "${value//$'\n'/ }"
  elif [ -n "$value" ]; then
    printf '****'
  fi
}

# Print merged variables sorted by name.
# show_values: false (name and source file), masked or full (NAME=value)
# colour: true dims the = and source files and tints values
print_merged_env() {
  local _kcm_show_values="$1" _kcm_dim="" _kcm_tint="" _kcm_off=""
  local _kcm_width=0 _kcm_name _kcm_k _kcm_value
  if [ "${2:-false}" = true ]; then _kcm_dim=$'\033[90m'; _kcm_tint=$'\033[36m'; _kcm_off=$'\033[0m'; fi
  for _kcm_name in ${_KCM_MERGED_NAMES[@]+"${_KCM_MERGED_NAMES[@]}"}; do
    [ "${#_kcm_name}" -gt "$_kcm_width" ] && _kcm_width=${#_kcm_name}
  done

  # Names are valid identifiers, so "NAME index" lines sort safely
  for _kcm_k in "${!_KCM_MERGED_NAMES[@]}"; do
    printf '%s %s\n' "${_KCM_MERGED_NAMES[$_kcm_k]}" "$_kcm_k"
  done | LC_ALL=C sort | while read -r _kcm_name _kcm_k; do
    if [ "$_kcm_show_values" = false ]; then
      printf '%-*s  %s%s%s\n' "$_kcm_width" "$_kcm_name" "$_kcm_dim" "${_KCM_MERGED_SOURCES[$_kcm_k]}" "$_kcm_off"
      continue
    fi
    _kcm_value="${_KCM_MERGED_VALUES[$_kcm_k]}"
    # printenv adds one newline; the x keeps any newlines of the value itself
    if is_exported "$_kcm_name"; then _kcm_value=$(printenv "$_kcm_name"; echo x); _kcm_value="${_kcm_value%$'\nx'}"; fi
    if [ "$_kcm_show_values" = masked ]; then
      _kcm_value=$(mask_value "$_kcm_value")
      _kcm_value="${_kcm_value//…/${_kcm_dim}…${_kcm_tint}}"
    fi
    # Close and reopen the tint at each line break so less -R keeps it per line
    _kcm_value="${_kcm_value//$'\n'/$_kcm_off$'\n'$_kcm_tint}"
    printf '%s%s=%s%s%s%s\n' "$_kcm_name" "$_kcm_dim" "$_kcm_off" "$_kcm_tint" "$_kcm_value" "$_kcm_off"
  done
}

# Load FILE, or discover env files when it is empty, and merge them (see merge_env_files)
load_env_files() {
  _KCM_ENV_FILES=()
  if [ -z "$1" ]; then
    discover_env_files
  elif [ -f "$1" ]; then
    _KCM_ENV_FILES=("$1")
  else
    info "Warning: env file '$1' not found, proceeding without it"
  fi

  # Like dotenv, variables already in the environment are not overridden
  _KCM_EXPORTED_NAMES=$'\n'"$(compgen -e)"$'\n'
  merge_env_files

  # kcm's locals use these prefixes, so one could hide an exported variable of the same name
  local _kcm_k
  for _kcm_k in "${!_KCM_MERGED_NAMES[@]}"; do
    case "${_KCM_MERGED_NAMES[$_kcm_k]}" in
      _KCM_*|_kcm_*) error_exit "${_KCM_MERGED_SOURCES[$_kcm_k]}: ${_KCM_MERGED_NAMES[$_kcm_k]} is reserved by kcm" ;;
    esac
  done
}

# Function to use secrets from env file
use_secrets() {
  local _kcm_env_file=""
  local _kcm_show_values=false
  local _kcm_args=()

  # Parse arguments
  while [ $# -gt 0 ]; do
    case "$1" in
      -e|--env-file)
        if [ -z "${2:-}" ]; then
          error_exit "-e/--env-file requires an argument"
        fi
        _kcm_env_file="$2"
        shift 2
        ;;
      -u|--allow-unsafe)
        # Kept so existing scripts still work; values are never evaluated, so nothing is blocked
        shift
        ;;
      -s|--show-values)
        _kcm_show_values=masked
        shift
        ;;
      --full)
        _kcm_show_values=full
        shift
        ;;
      -h|--help)
        show_command_help use | colorize_help
        exit 0
        ;;
      --)
        shift
        break
        ;;
      *)
        _kcm_args+=("$1")
        shift
        ;;
    esac
  done

  # Add remaining arguments after --
  while [ $# -gt 0 ]; do
    _kcm_args+=("$1")
    shift
  done

  load_env_files "$_kcm_env_file"

  # The only locals in scope here use the _kcm_ prefix. Other unexported
  # variables already declared by the shell belong to Bash.
  local _kcm_k _kcm_name
  for _kcm_k in "${!_KCM_MERGED_NAMES[@]}"; do
    _kcm_name="${_KCM_MERGED_NAMES[$_kcm_k]}"
    is_exported "$_kcm_name" && continue
    case "$_kcm_name" in
      # Bash sets these but they are plain, writable variables
      HOSTNAME|HOSTTYPE|MACHTYPE|OSTYPE|OPTIND|OPTERR) continue ;;
      BASH_ENV|BASH_XTRACEFD|BASH_REMATCH|OPTARG|POSIXLY_CORRECT) ;;
      *) declare -p "$_kcm_name" >/dev/null 2>&1 || continue ;;
    esac
    error_exit "${_KCM_MERGED_SOURCES[$_kcm_k]}: $_kcm_name is managed by Bash"
  done
  if [ ${#_kcm_args[@]} -gt 0 ] || [ "$_kcm_show_values" != false ]; then
    resolve_env_values
  fi

  # No command: list what would be loaded
  if [ ${#_kcm_args[@]} -eq 0 ]; then
    local _kcm_colour=false
    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then _kcm_colour=true; fi
    if [ "$_kcm_show_values" = full ] && [ -t 1 ]; then
      # less keeps secrets off the scrollback: -+F -+X force its separate screen even if $LESS disables it
      print_merged_env full "$_kcm_colour" | less -R -+F -+X || true
    else
      print_merged_env "$_kcm_show_values" "$_kcm_colour"
    fi
    return 0
  fi

  for _kcm_k in "${!_KCM_MERGED_NAMES[@]}"; do
    if is_exported "${_KCM_MERGED_NAMES[$_kcm_k]}"; then continue; fi
    export "${_KCM_MERGED_NAMES[$_kcm_k]}=${_KCM_MERGED_VALUES[$_kcm_k]}"
  done

  # Execute the command with the processed environment
  exec "${_kcm_args[@]}"
}

# Print each merged variable as NAME='value', in quotes both kcm and dotenv read literally.
# dotenv expands \n and \r inside "...", so "..." is only used for values with ' and neither of those.
# A carriage return can't be kept: dotenv turns it into a newline and kcm drops it at a line end.
# Locals use the _kcm_ prefix, so they can't hide an exported variable that printenv reads.
format_env_file() {
  local _kcm_k _kcm_name _kcm_value
  for _kcm_k in "${!_KCM_MERGED_NAMES[@]}"; do
    _kcm_name="${_KCM_MERGED_NAMES[$_kcm_k]}"
    _kcm_value="${_KCM_MERGED_VALUES[$_kcm_k]}"
    # printenv adds one newline; the x keeps any newlines of the value itself
    if is_exported "$_kcm_name"; then _kcm_value=$(printenv "$_kcm_name"; echo x); _kcm_value="${_kcm_value%$'\nx'}"; fi
    if [[ "$_kcm_value" == *$'\r'* ]]; then
      error_exit "Cannot quote $_kcm_name for an env file: its value has a carriage return"
    elif [[ "$_kcm_value" != *"'"* ]]; then
      printf "%s='%s'\n" "$_kcm_name" "$_kcm_value"
    elif [[ "$_kcm_value" != *'"'* && "$_kcm_value" != *'\n'* && "$_kcm_value" != *'\r'* ]]; then
      printf '%s="%s"\n' "$_kcm_name" "$_kcm_value"
    else
      error_exit "Cannot quote $_kcm_name for an env file: its value has ' and also \" or a literal \\\\n or \\\\r"
    fi
  done
}

# Resolve env files and write them as plain values to a file, the clipboard or a pipe
export_secrets() {
  local _kcm_env_file="" _kcm_out="" _kcm_to_clipboard=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -e|--env-file)
        [ -n "${2:-}" ] || error_exit "-e/--env-file requires an argument"
        _kcm_env_file="$2"
        shift 2
        ;;
      -o|--output)
        [ -n "${2:-}" ] || error_exit "-o/--output requires an argument"
        _kcm_out="$2"
        shift 2
        ;;
      -c|--copy)
        _kcm_to_clipboard=true
        shift
        ;;
      *)
        error_exit "Unknown option '$1'. Usage: $_KCM_SCRIPT_NAME export [-e FILE] [-o FILE | -c]"
        ;;
    esac
  done
  # Checked before any Keychain prompt
  if [ -n "$_kcm_out" ] && [ "$_kcm_to_clipboard" = true ]; then
    error_exit "Use either -o or -c, not both"
  fi
  if [ -n "$_kcm_out" ] && { [ -e "$_kcm_out" ] || [ -L "$_kcm_out" ]; }; then
    error_exit "'$_kcm_out' already exists"
  fi
  # Others could swap the temp file in a folder they can write to, unless it is sticky and owned
  # by root or you (a sticky folder's owner can still replace files). -H checks a symlink's target.
  # shortcut: parent folders and ACLs are not checked, see SECURITY.md
  if [ -n "$_kcm_out" ] && [ -n "$(find -H "$(dirname "$_kcm_out")" -maxdepth 0 \( -perm -0020 -o -perm -0002 \) \
      ! \( -perm -1000 \( -user 0 -o -user "$(id -u)" \) \) 2>/dev/null)" ]; then
    error_exit "Other users can write to the folder of '$_kcm_out'. Export to a folder only you can write to"
  fi

  load_env_files "$_kcm_env_file"
  resolve_env_values strict
  local _kcm_text _kcm_count=${#_KCM_MERGED_NAMES[@]}
  # The x keeps the final newline; the subshell's error_exit stops kcm too
  _kcm_text=$(format_env_file && printf x) || exit 1
  _kcm_text="${_kcm_text%x}"

  if [ "$_kcm_to_clipboard" = true ]; then
    copy_to_clipboard "$_kcm_text"
    success "Copied $_kcm_count variables to clipboard"
    info "Clipboard will be cleared in 45 seconds for security"
  elif [ -n "$_kcm_out" ]; then
    # mktemp creates a new 600 file; ln then fails on any existing entry, FIFOs included,
    # even one that appeared since the check above
    _KCM_EXPORT_TMP=$(mktemp "$(dirname "$_kcm_out")/.kcm-export.XXXXXX") || error_exit "Cannot write '$_kcm_out'"
    trap 'rm -f "${_KCM_EXPORT_TMP:-}"' EXIT
    trap 'exit 130' INT TERM
    if ! printf '%s' "$_kcm_text" > "$_KCM_EXPORT_TMP" || ! ln "$_KCM_EXPORT_TMP" "$_kcm_out" 2>/dev/null; then
      error_exit "Cannot write '$_kcm_out'"
    fi
    success "Exported $_kcm_count variables to $_kcm_out"
    local _kcm_ignored=0
    git -C "$(dirname "$_kcm_out")" check-ignore -q -- "$(basename "$_kcm_out")" 2>/dev/null || _kcm_ignored=$?
    # 1: inside a repo and not ignored (128: not a repo)
    if [ "$_kcm_ignored" -eq 1 ]; then
      info "Warning: git doesn't ignore $_kcm_out, so it could be committed"
    fi
  elif [ -t 1 ]; then
    # Same pager as use --full, so the values stay out of terminal scrollback
    printf '%s' "$_kcm_text" | less -R -+F -+X || true
  else
    printf '%s' "$_kcm_text"
  fi
}

# Write a script that runs a command through kcm use when kcm is installed,
# so committed scripts work for people without kcm
install_wrapper() {
  local default="scripts/with-env" path="${1:-}" root target
  root=$(find_git_root) || error_exit "Not in a git repository"

  if [ -z "$path" ]; then
    # read prints the prompt only in a terminal; no answer means the default
    read -r -p "Location relative to $root [$default]: " path || true
    path="${path:-$default}"
  fi
  case "$path" in /*|..|../*|*/../*|*/..) error_exit "Location must be inside the git root" ;; esac
  target="$root/$path"

  local script
  script=$(cat << 'WRAPPER'
#!/bin/sh
# Resolve keychain:// secrets with kcm when it is installed, otherwise run the command as is.
# See https://github.com/tyom/kcm
command -v kcm >/dev/null 2>&1 && exec kcm use -- "$@"
exec "$@"
WRAPPER
)

  if [ -e "$target" ]; then
    [ "$(cat "$target")" = "$script" ] || error_exit "$path already exists and is not the kcm wrapper"
    info "$path is already installed"
  else
    mkdir -p "$(dirname "$target")"
    printf '%s\n' "$script" > "$target"
    success "Installed $path"
  fi
  chmod +x "$target"
  info "Use it in scripts, e.g. \"dev\": \"$path vite\", and commit it"
}

# Print why a value looks like a secret ("name has KEY, starts with sk-"), or nothing
secret_reason() {
  local name="$1" value="$2" reasons="" word prefix
  # Longer words first, so DB_PASSWORD reports PASSWORD rather than PASS.
  # nocasematch instead of upper-casing: bash 3.2 has no ${name^^}
  shopt -s nocasematch
  for word in PASSWORD CREDENTIAL PRIVATE SECRET TOKEN SALT AUTH PASS PWD DSN KEY; do
    if [[ "$name" == *"$word"* ]]; then reasons="name has $word"; break; fi
  done
  shopt -u nocasematch
  local url_re='^[A-Za-z][A-Za-z0-9+.-]*://[^/:@]+:[^/@]+@'
  local kind=""
  case "$value" in
    -----BEGIN*) kind="private key" ;;
    eyJ*.*.*) kind="JWT" ;;
    *)
      for prefix in sk_live_ sk_test_ rk_live_ sk- github_pat_ ghp_ gho_ ghs_ glpat- xoxa- xoxb- xoxp- xoxr- AKIA AIza npm_; do
        if [[ "$value" == "$prefix"* ]]; then kind="starts with $prefix"; break; fi
      done
      if [ -z "$kind" ] && [[ "$value" =~ $url_re ]]; then
        kind="URL with password"
      elif [ -z "$kind" ] && [ ${#value} -ge 32 ] && [[ "$value" =~ ^[^[:space:]]+$ ]] \
        && [[ "$value" =~ [A-Za-z] ]] && [[ "$value" =~ [0-9] ]]; then
        kind="looks random"
      fi
      ;;
  esac
  [ -n "$kind" ] && reasons="${reasons:+$reasons, }$kind"
  printf '%s' "$reasons"
}

# Find every .env and .env.* file from cwd up to the git root (cwd only outside git).
# Unlike discover_env_files, not limited to the current mode. Sets _KCM_ENV_FILES.
discover_import_files() {
  local dir rel="./" root f name
  dir=$(pwd -P)
  root=$(find_git_root) || root="$dir"
  while :; do
    # Highest priority first (.local before the rest, .env last), so a name clash
    # offers the plain Keychain name to the file `use` would read
    for f in "$dir"/.env.*.local "$dir/.env.local" "$dir"/.env.* "$dir/.env"; do
      [ -f "$f" ] || continue
      name="${f##*/}"
      case "$name" in *.example|*.sample|*.template) continue ;; esac
      case " ${_KCM_ENV_FILES[*]+${_KCM_ENV_FILES[*]}} " in *" $rel$name "*) continue ;; esac
      _KCM_ENV_FILES+=("$rel$name")
    done
    [ "$dir" = "$root" ] && break
    dir="${dir%/*}"; dir="${dir:-/}"
    if [ "$rel" = "./" ]; then rel="../"; else rel="../$rel"; fi
  done
}

abort_import() {
  info "Import cancelled, nothing changed"
  exit 1
}

# The two pickers below run inside import_secrets and update its picked array, using
# its n (pickable rows), total (rows incl. existing references), rows, marks, tints and header.

# Pick by typing numbers or ranges (used when input is not a terminal)
pick_import_numbers() {
  local input tok a b i box
  local -a toks
  while :; do
    echo "" >&2
    printf '     #  %s\n' "$header" >&2
    for (( i=0; i<total; i++ )); do
      if [ "$i" -lt "$n" ]; then
        box='[ ]'; [ "${picked[i]}" = true ] && box='[x]'
        printf '%b%s %2d  %s%b\n' "${tints[i]}" "$box" $((i + 1)) "${rows[i]}" "$_KCM_NC" >&2
      else
        printf '%b%s     %s%b\n' "${tints[i]}" "${marks[i]}" "${rows[i]}" "$_KCM_NC" >&2
      fi
    done
    echo "" >&2
    IFS= read -r -p "Toggle (e.g. 3 or 1-2), Enter to continue, q to quit: " input || abort_import
    case "$input" in
      '') break ;;
      q|Q) abort_import ;;
    esac
    read -ra toks <<< "${input//,/ }"
    for tok in ${toks[@]+"${toks[@]}"}; do
      if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        a=$((10#${BASH_REMATCH[1]})); b=$((10#${BASH_REMATCH[2]}))
      elif [[ "$tok" =~ ^[0-9]+$ ]]; then
        a=$((10#$tok)); b=$a
      else
        info "Ignoring '$tok'"
        continue
      fi
      [ "$a" -lt 1 ] && a=1
      [ "$b" -gt "$n" ] && b=$n
      for (( i=a; i<=b; i++ )); do
        if [ "${picked[i-1]}" = true ]; then picked[i-1]=false; else picked[i-1]=true; fi
      done
    done
  done
}

# Pick with keys in a terminal: up/down or k/j move, space toggles, a toggles all,
# Enter accepts, q quits. Redraws in place and scrolls when the list is taller than the screen.
pick_import_keys() {
  local cur=0 top=0 height drawn=0 key rest i line term_rows term_cols box status
  # Hidden cursor, restored however kcm exits
  printf '\033[?25l' >&2
  trap 'printf "\033[?25h" >&2' EXIT
  trap 'exit 130' INT TERM
  echo "" >&2
  while :; do
    read -r term_rows term_cols <<< "$(stty size 2>/dev/null)" || true
    # Some terminals report 0 0 (e.g. under script); assume 24x80
    [ "${term_rows:-0}" -gt 0 ] || term_rows=24
    [ "${term_cols:-0}" -gt 10 ] || term_cols=80
    height=$((term_rows - 4))
    [ "$height" -lt 3 ] && height=3
    [ "$height" -gt "$total" ] && height=$total
    [ "$cur" -lt "$top" ] && top=$cur
    [ "$cur" -ge $((top + height)) ] && top=$((cur - height + 1))
    # The screen may have grown since the last draw
    [ $((top + height)) -gt "$total" ] && top=$((total - height))

    # Back to the top of the last draw and clear below it
    [ "$drawn" -gt 0 ] && printf '\033[%dA\033[J' "$drawn" >&2
    # Rows start with "> [x]  " (7 chars), so the header needs 7 spaces
    line="       $header"
    printf '%s\n' "${line:0:term_cols-1}" >&2
    for (( i=top; i<top+height; i++ )); do
      if [ "$i" -ge "$n" ]; then box="${marks[i]}"
      elif [ "${picked[i]}" = true ]; then box='[x]'
      else box='[ ]'; fi
      line="$box  ${rows[i]}"
      # Cut to the screen width: a wrapped line would break the redraw
      line="${line:0:term_cols-3}"
      if [ "$i" -eq "$cur" ]; then
        # Dark text on light grey: softer than reverse video, and readable on any theme.
        # The row's own tint is dropped here, as green or yellow would not read on grey.
        printf '\033[48;5;250;38;5;234m> %s\033[0m\n' "$line" >&2
      else
        printf '%b  %s%b\n' "${tints[i]}" "$line" "$_KCM_NC" >&2
      fi
    done
    status="↑/↓ move  space toggle  a all  enter continue  q quit"
    [ "$total" -gt "$height" ] && status="$status  ($((top + 1))-$((top + height)) of $total)"
    printf '%b%s%b\n' "$_KCM_GREY" "${status:0:term_cols-1}" "$_KCM_NC" >&2
    drawn=$((height + 2))

    IFS= read -rsn1 key || abort_import
    if [ "$key" = $'\033' ]; then
      # Arrow keys send ESC [ A/B (or ESC O A/B); a lone Esc just times out
      IFS= read -rsn2 -t 1 rest || rest=""
      case "$rest" in
        '[A'|'OA') key=up ;;
        '[B'|'OB') key=down ;;
        *) key=ignore ;;
      esac
    fi
    case "$key" in
      up|k) if [ "$cur" -gt 0 ]; then cur=$((cur - 1)); fi ;;
      # The cursor can reach reference rows so long lists can scroll to them; they can't be ticked
      down|j) if [ "$cur" -lt $((total - 1)) ]; then cur=$((cur + 1)); fi ;;
      ' ')
        if [ "$cur" -lt "$n" ]; then
          if [ "${picked[cur]}" = true ]; then picked[cur]=false; else picked[cur]=true; fi
        fi
        ;;
      a|A)
        # Tick all, or untick all when everything is already ticked
        box=false
        for (( i=0; i<n; i++ )); do [ "${picked[i]}" = true ] || box=true; done
        for (( i=0; i<n; i++ )); do picked[i]=$box; done
        ;;
      '') break ;;
      q|Q) abort_import ;;
    esac
  done
  printf '\033[?25h' >&2
  trap - EXIT INT TERM
}

# Rewrite FILE, replacing assignments given as "start:end:NAME=..." specs.
# SUM is the file's cksum when the line ranges were read; a file that no longer matches is left alone.
# Writes a temp file next to it and moves it over, so a failed write leaves the file intact.
rewrite_env_file() {
  local file="$1" sum="$2"; shift 2
  local tmp lineno=0 skip_to=0 line spec rest out
  tmp=$(mktemp "$(dirname "$file")/.kcm-import.XXXXXX") || return 1
  # The temp file holds the other lines in plain text, so remove it if kcm is interrupted
  _KCM_IMPORT_TMP="$tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    [ "$lineno" -le "$skip_to" ] && continue
    out="$line"
    for spec in "$@"; do
      [ "${spec%%:*}" = "$lineno" ] || continue
      rest="${spec#*:}"
      skip_to="${rest%%:*}"
      out="${rest#*:}"
      [[ "$line" == "export "* ]] && out="export $out"
      [[ "$line" == *$'\r' ]] && out="$out"$'\r'
      break
    done
    # The loop's status is only its last command's, so check every write
    printf '%s\n' "$out" || { rm -f "$tmp"; return 1; }
  done < "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  # shortcut: mv replaces a symlinked env file with a regular file; resolve links if that comes up
  # /usr/bin/stat: GNU stat from coreutils takes different flags. -L: the mode of the file read, not of a link
  # Checked last, so an edit at any point since the scan (prompts, Keychain writes) is caught
  if [ "$(cksum < "$file")" != "$sum" ]; then
    rm -f "$tmp"
    _KCM_IMPORT_TMP=""
    return 2
  fi
  chmod "$(/usr/bin/stat -L -f %Lp "$file")" "$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
  _KCM_IMPORT_TMP=""
}

# Move plain values from env files into Keychain and replace them with keychain:// references
import_secrets() {
  if ! command -v security >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'security' command"
  fi

  local env_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -e|--env-file)
        [ -n "${2:-}" ] || error_exit "-e/--env-file requires an argument"
        env_file="$2"
        shift 2
        ;;
      *) error_exit "Unknown option '$1'. Usage: $_KCM_SCRIPT_NAME import [-e FILE]" ;;
    esac
  done

  _KCM_ENV_FILES=()
  if [ -n "$env_file" ]; then
    [ -f "$env_file" ] || error_exit "Env file '$env_file' not found"
    _KCM_ENV_FILES=("$env_file")
  else
    discover_import_files
    [ ${#_KCM_ENV_FILES[@]} -gt 0 ] || error_exit "No .env files found"
  fi
  local list
  printf -v list '%s, ' "${_KCM_ENV_FILES[@]}"
  info "Scanning ${list%, }"

  local -a names=() values=() files=() lines=() whys=() picked=() tracked=() tints=() sums=()
  # Default Keychain label per row and what the scan found there: "", readable or unreadable
  local -a labels=() kc_states=() kc_values=()
  # Lines that already hold a keychain:// reference, shown after the others
  local -a ref_names=() ref_files=() ref_whys=() ref_marks=() ref_tints=()
  local file idx value why state tick tint is_tracked label existing n=0 m=0 in_keychain sum
  # One attribute dump instead of a lookup per variable
  in_keychain=$'\n'"$(keychain_services '.*' | cut -d' ' -f2- | cut -f1 | LC_ALL=C sort -u)"$'\n'
  for file in "${_KCM_ENV_FILES[@]}"; do
    is_tracked=false
    git -C "$(dirname "$file")" ls-files --error-unmatch -- "$(basename "$file")" >/dev/null 2>&1 && is_tracked=true
    # Line ranges are only valid for this content: checked again before anything is stored
    sum=$(cksum < "$file")
    process_env_file "$file"
    for idx in ${_KCM_PROCESSED_ENV_NAMES[@]+"${!_KCM_PROCESSED_ENV_NAMES[@]}"}; do
      value="${_KCM_PROCESSED_ENV_VALUES[$idx]}"
      [ -n "$value" ] || continue
      if [[ "$value" == keychain://* ]]; then
        ref_names[m]="${_KCM_PROCESSED_ENV_NAMES[$idx]}"
        ref_files[m]="$file"
        if ! [[ "$in_keychain" == *$'\n'"${value#keychain://}"$'\n'* ]]; then
          ref_marks[m]='!'; ref_tints[m]="$_KCM_YELLOW"; ref_whys[m]="$value missing from Keychain"
        elif select_keychain_item "${value#keychain://}"; then
          ref_marks[m]='✓'; ref_tints[m]="$_KCM_GREY"; ref_whys[m]="$value"
        else
          ref_marks[m]='!'; ref_tints[m]="$_KCM_YELLOW"; ref_whys[m]="$value cannot be selected"
        fi
        m=$((m + 1))
        continue
      fi
      # Notes: reasons it looks secret, then after a dot what changed the default tick
      why=$(secret_reason "${_KCM_PROCESSED_ENV_NAMES[$idx]}" "$value")
      state=""; tint=""
      tick=false
      [ -n "$why" ] && tick=true
      label="${_KCM_PROCESSED_ENV_NAMES[$idx]}"
      while [[ "$label" == _* ]]; do label="${label#_}"; done
      labels[n]="$label"; kc_states[n]=""; kc_values[n]=""
      if [[ "$in_keychain" == *$'\n'"$label"$'\n'* ]]; then
        if existing=$(read_secret "$label" && printf x); then existing="${existing%x}"; kc_states[n]=readable; kc_values[n]="$existing"
        elif [ "$?" -eq 2 ]; then kc_states[n]=conflict
        else kc_states[n]=unreadable; fi
        if [ "${kc_states[n]}" = conflict ]; then
          state="Keychain name cannot be selected"; tint="$_KCM_YELLOW"; tick=false
        elif [ "${kc_states[n]}" = unreadable ]; then
          state="${state:+$state, }in Keychain, unreadable"; tint="$_KCM_YELLOW"
        elif [ "$existing" = "$value" ]; then
          # Only the reference is written, nothing new is stored
          state="${state:+$state, }in Keychain, same value"; tint="$_KCM_GREEN"; tick=true
        else
          state="${state:+$state, }in Keychain, different value"; tint="$_KCM_YELLOW"
        fi
      fi
      case "${_KCM_PROCESSED_ENV_NAMES[$idx]}" in
        # Bundlers ship these to the client, so they are public by design
        NEXT_PUBLIC_*|VITE_*|PUBLIC_*|EXPO_PUBLIC_*|REACT_APP_*)
          if [ "$tick" = true ]; then tick=false; state="${state:+$state, }public, so unticked"; fi ;;
      esac
      if [ "$is_tracked" = true ]; then
        if [ "$tick" = true ]; then state="${state:+$state, }tracked by git, so unticked"
        else state="${state:+$state, }tracked by git"; fi
        tick=false
      fi
      if [ -n "$why" ] && [ -n "$state" ]; then why="$why · $state"; else why="$why$state"; fi
      names[n]="${_KCM_PROCESSED_ENV_NAMES[$idx]}"
      values[n]="$value"
      files[n]="$file"
      lines[n]="${_KCM_PROCESSED_ENV_LINES[$idx]}"
      whys[n]="$why"
      picked[n]="$tick"
      tracked[n]="$is_tracked"
      tints[n]="$tint"
      sums[n]="$sum"
      n=$((n + 1))
    done
  done
  if [ "$n" -eq 0 ]; then
    for (( idx=0; idx<m; idx++ )); do
      printf '%s %s  %s  %s\n' "${ref_marks[idx]}" "${ref_names[idx]}" "${ref_files[idx]}" "${ref_whys[idx]}" >&2
    done
    info "No plain values to import"
    return 0
  fi

  # Row text without the tick box, built once so redraws need no subshells
  local nw=4 fw=4 i mask header row total=$((n + m))
  local -a rows=() marks=()
  for (( i=0; i<n; i++ )); do
    [ ${#names[i]} -gt "$nw" ] && nw=${#names[i]}
    [ ${#files[i]} -gt "$fw" ] && fw=${#files[i]}
  done
  for (( i=0; i<m; i++ )); do
    [ ${#ref_names[i]} -gt "$nw" ] && nw=${#ref_names[i]}
    [ ${#ref_files[i]} -gt "$fw" ] && fw=${#ref_files[i]}
  done
  printf -v header '%-*s  %-*s  %-9s  %s' "$nw" NAME "$fw" FILE VALUE NOTES
  for (( i=0; i<n; i++ )); do
    mask=$(mask_value "${values[i]}")
    # Pad by characters: printf pads by bytes, and … is 3 bytes
    # bash 3.2 printf -v can't write an array element
    printf -v row '%-*s  %-*s  %s%*s  %s' "$nw" "${names[i]}" "$fw" "${files[i]}" \
      "$mask" $((9 - ${#mask})) '' "${whys[i]}"
    rows[i]="$row"
  done
  # Reference rows have a fixed mark instead of a tick box and can't be picked
  for (( i=0; i<m; i++ )); do
    printf -v row '%-*s  %-*s  %-9s  %s' "$nw" "${ref_names[i]}" "$fw" "${ref_files[i]}" '' "${ref_whys[i]}"
    rows[n+i]="$row"
    marks[n+i]="${ref_marks[i]}  "
    tints[n+i]="${ref_tints[i]}"
  done

  if [ -t 0 ] && [ -t 2 ]; then
    pick_import_keys
  else
    pick_import_numbers
  fi

  # Choose a Keychain label for each picked value. action: store, ref (already there) or skip
  local repo label existing found answer j clash_with shown
  local -a actions=() ref_values=()
  repo=$(find_git_root 2>/dev/null || pwd -P)
  repo=$(printf '%s' "${repo##*/}" | tr '[:lower:]' '[:upper:]' | tr -c 'A-Z0-9' '_')
  for (( i=0; i<n; i++ )); do
    actions[i]=skip
    [ "${picked[i]}" = true ] || continue
    label="${labels[i]}"
    while :; do
      if ! [[ "$label" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]]; then
        info "'$label' can't be a Keychain name: use a letter first, then letters, numbers and underscores"
        IFS= read -r -p "Keychain name for ${names[i]}: " label || abort_import
        case "$label" in q|Q) abort_import ;; esac
        continue
      fi
      # Values picked earlier in this run are not stored yet, so check them first
      found=false; clash_with="in Keychain"; shown=""
      for (( j=0; j<i; j++ )); do
        if [ "${actions[j]}" = store ] && [ "${labels[j]}" = "$label" ]; then
          found=true; existing="${values[j]}"; clash_with="picked from ${files[j]}"
        fi
      done
      # The scan already read the default label: don't read it (or prompt) again
      if [ "$found" = false ] && [ "$label" = "${labels[i]}" ] && [ -n "${kc_states[i]}" ]; then
        [ "${kc_states[i]}" != conflict ] || error_exit "Cannot import ${names[i]} under Keychain name '$label'"
        found=true; existing="${kc_values[i]}"
        [ "${kc_states[i]}" = unreadable ] && shown="unreadable"
      elif [ "$found" = false ]; then
        if existing=$(read_secret "$label" && printf x); then
          existing="${existing%x}"; found=true
        elif [ "$?" -eq 2 ]; then
          error_exit "Cannot import ${names[i]} under Keychain name '$label'"
        elif select_keychain_item "$label"; then
          # Exists but kcm can't read it: never overwrite it unasked
          found=true; existing=""; shown="unreadable"
        fi
      fi
      if [ "$found" = false ]; then actions[i]=store; break; fi
      # What the reference should find when the file is rewritten; unreadable entries can only be checked for existence
      if [ -n "$shown" ]; then ref_values[i]="?"; else ref_values[i]="=$existing"; fi
      if [ -z "$shown" ] && [ "$existing" = "${values[i]}" ]; then actions[i]=ref; break; fi

      info "$label is $clash_with with a different value (${shown:-$(mask_value "$existing")}) than ${files[i]} ($(mask_value "${values[i]}"))"
      IFS= read -r -p "[o]verwrite  [k]eep that value (drops the file value)  [r]ename  [s]kip: " answer || abort_import
      case "$answer" in
        o|O) actions[i]=store; break ;;
        k|K) actions[i]=ref; break ;;
        s|S) break ;;
        q|Q) abort_import ;;
        r|R)
          IFS= read -r -p "New Keychain name [${repo}_$label]: " answer || abort_import
          case "$answer" in q|Q) abort_import ;; esac
          label="${answer:-${repo}_$label}"
          ;;
      esac
    done
    labels[i]="$label"
  done

  # Summary and confirmation
  local stores=0
  local -a touched=()
  echo "" >&2
  for (( i=0; i<n; i++ )); do
    case "${actions[i]}" in
      store) stores=$((stores + 1)); echo "  ${names[i]} (${files[i]}) → keychain://${labels[i]}" >&2 ;;
      ref) echo "  ${names[i]} (${files[i]}) → keychain://${labels[i]} (already in Keychain)" >&2 ;;
      *) continue ;;
    esac
    case " ${touched[*]+${touched[*]}} " in *" ${files[i]} "*) ;; *) touched+=("${files[i]}") ;; esac
  done
  if [ ${#touched[@]} -eq 0 ]; then
    info "Nothing to import"
    return 0
  fi
  IFS= read -r -p "Store $stores secret(s) and update ${#touched[@]} file(s)? [y/N] " answer || abort_import
  case "$answer" in y|Y|yes|YES) ;; *) abort_import ;; esac

  # A file edited during the prompts no longer matches the scanned line ranges
  local failed=false
  for file in "${touched[@]}"; do
    for (( i=0; i<n; i++ )); do
      [ "${files[i]}" = "$file" ] || continue
      [ "$(cksum < "$file")" = "${sums[i]}" ] && break
      info "Warning: $file changed since the scan, leaving it as is; run import again"
      failed=true
      for (( j=0; j<n; j++ )); do
        if [ "${files[j]}" = "$file" ]; then actions[j]=skip; fi
      done
      break
    done
  done

  # Store first; a line is only replaced once its value reads back from Keychain
  local source_path
  for (( i=0; i<n; i++ )); do
    [ "${actions[i]}" = store ] || continue
    source_path="$(cd "$(dirname "${files[i]}")" && pwd -P)/${files[i]##*/}"
    case "$source_path" in "$HOME"/*) source_path="~${source_path#"$HOME"}" ;; esac
    if ! store_secret "${labels[i]}" "${values[i]}" "Imported by kcm from $source_path"; then
      info "Warning: could not store ${names[i]} from ${files[i]}, leaving it as is"
      failed=true
      # Rows that chose to keep this value would point at an entry that never got it
      for (( j=0; j<n; j++ )); do
        if [ "${labels[j]}" = "${labels[i]}" ]; then actions[j]=skip; fi
      done
    fi
  done

  # Check each entry still holds the value its reference stands for: the prompts give another
  # process time to change a kept entry, and a later pick in this run can overwrite a stored one
  local got
  for (( i=0; i<n; i++ )); do
    case "${actions[i]}" in
      ref) ;;
      store) ref_values[i]="=${values[i]}" ;;
      *) continue ;;
    esac
    if [ "${ref_values[i]}" = "?" ]; then
      select_keychain_item "${labels[i]}" && continue
    elif got=$(read_secret "${labels[i]}" && printf x) && [ "=$got" = "${ref_values[i]}x" ]; then
      continue
    fi
    info "Warning: ${labels[i]} no longer holds the value from ${files[i]}, leaving ${names[i]} there as is"
    actions[i]=skip
    failed=true
  done

  local -a specs
  local imported=0 rotate="" status
  _KCM_IMPORT_TMP=""
  trap 'rm -f "${_KCM_IMPORT_TMP:-}"' EXIT
  trap 'exit 130' INT TERM
  for file in "${touched[@]}"; do
    specs=()
    for (( i=0; i<n; i++ )); do
      [ "${actions[i]}" != skip ] && [ "${files[i]}" = "$file" ] || continue
      specs+=("${lines[i]}:${names[i]}=\"keychain://${labels[i]}\"")
      sum="${sums[i]}"
      [ "${tracked[i]}" = true ] && rotate="${rotate:+$rotate, }${names[i]}"
    done
    [ ${#specs[@]} -gt 0 ] || continue
    status=0
    rewrite_env_file "$file" "$sum" "${specs[@]}" || status=$?
    if [ "$status" -eq 0 ]; then
      imported=$((imported + ${#specs[@]}))
      success "Updated $file"
    elif [ "$status" -eq 2 ]; then
      info "Warning: $file changed during import, leaving it as is; its values are in Keychain, run import again"
      failed=true
    else
      info "Warning: could not update $file; its values are in Keychain, replace them by hand"
      failed=true
    fi
  done

  success "Imported $imported value(s)"
  info "Check with: $_KCM_SCRIPT_NAME use -s"
  if [ -n "$rotate" ]; then
    info "Old values stay in git history: rotate $rotate"
  fi
  [ "$failed" = false ]
}

# Function to remove secret from keychain
remove_secret() {
  if ! command -v security >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'security' command"
  fi

  if [ $# -lt 1 ]; then
    error_exit "KEY_NAME is required. Usage: $_KCM_SCRIPT_NAME remove KEY_NAME"
  fi

  local KEY_NAME="$1"

  if select_keychain_item "$KEY_NAME"; then
    # Delete the entry
    if security delete-generic-password -s "$KEY_NAME" -a "$_KCM_ITEM_ACCOUNT" "$_KCM_ITEM_KEYCHAIN" >/dev/null 2>&1; then
      success "Secret '$KEY_NAME' removed from Keychain"
    else
      error_exit "Failed to remove secret '$KEY_NAME' from Keychain"
    fi
  else
    [ "$?" -eq 2 ] && exit 1
    error_exit "Secret '$KEY_NAME' not found or unreadable in Keychain"
  fi
}

# Function to show secret value
show_secret() {
  if ! command -v security >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'security' command"
  fi

  if [ $# -lt 1 ]; then
    error_exit "KEY_NAME is required. Usage: $_KCM_SCRIPT_NAME show KEY_NAME"
  fi

  local KEY_NAME="$1"
  local value

  # Get the secret value
  # The x keeps trailing newlines, so show | add round-trips the exact value
  if value=$(read_secret "$KEY_NAME" && printf x) && [ "$value" != x ]; then
    printf '%s\n' "${value%x}"
  else
    [ "$?" -eq 2 ] && exit 1
    error_exit "Secret '$KEY_NAME' not found or unreadable in Keychain"
  fi
}

# Put VALUE on the clipboard and clear it after 45 seconds,
# unless the user has copied something else since
copy_to_clipboard() {
  if ! command -v pbcopy >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'pbcopy' command"
  fi
  local value="$1"
  printf '%s' "$value" | pbcopy
  # Closed file descriptors keep the terminal from waiting on it
  (
    sleep 45
    if pasted=$(pbpaste && printf x) && [ "$pasted" = "${value}x" ]; then pbcopy </dev/null; fi
  ) </dev/null >/dev/null 2>&1 &
}

# Function to copy secret to clipboard
copy_secret() {
  if ! command -v security >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'security' command"
  fi

  if [ $# -lt 1 ]; then
    error_exit "KEY_NAME is required. Usage: $_KCM_SCRIPT_NAME copy KEY_NAME"
  fi

  local KEY_NAME="$1"
  local value

  # Get the secret value
  if value=$(read_secret "$KEY_NAME" && printf x) && [ "$value" != x ]; then
    copy_to_clipboard "${value%x}"
    success "Secret '$KEY_NAME' copied to clipboard"
    info "Clipboard will be cleared in 45 seconds for security"
  else
    [ "$?" -eq 2 ] && exit 1
    error_exit "Secret '$KEY_NAME' not found or unreadable in Keychain"
  fi
}

# Print "<origin> <service>", then a tab and the hint if kcm's entry has one, for each generic password in the keychain search list whose
# service matches REGEX. origin is kcm (creator "kcm "), legacy (untagged, as older kcm
# versions wrote them: no creator or kind, account $USER, a valid key name) or other.
# Reads attributes only, so it never asks for Keychain access.
keychain_services() {
  local regex="$1" exact="${2:-}" keychains keychain status
  keychains=$(security list-keychains) || return 1
  while IFS= read -r keychain; do
    [[ "$keychain" =~ ^[[:space:]]*\"(.*)\"[[:space:]]*$ ]] || continue
    keychain="${BASH_REMATCH[1]}"
    if [ -n "$exact" ]; then
      status=0
      security find-generic-password -s "$exact" "$keychain" >/dev/null 2>&1 || status=$?
      [ "$status" -eq 44 ] && continue
      [ "$status" -eq 0 ] || return 1
    fi
    security dump-keychain "$keychain" 2>/dev/null | KCM_CHAIN="$keychain" KCM_LABEL="$exact" awk -v regex="$regex" -v user="$USER" '
      # Attribute value: "text" without the quotes, or <NULL> as is
      function val(line) {
        sub(/^[^=]*=/, "", line)
        if (line ~ /^".*"$/) line = substr(line, 2, length(line) - 2)
        return line
      }
      function flush(  origin, rank) {
        if (genp && svc != "" && svc ~ regex) {
          if (crtr == "kcm ") origin = "kcm"
          else if (crtr == "<NULL>" && desc == "<NULL>" && acct == user && svc ~ /^[A-Za-z][A-Za-z0-9_]*$/) origin = "legacy"
          else origin = "other"
          # A hint follows one tab, or two when security printed it as hex.
          # 496D...6D is "Imported by kcm" in hex, for a source path with non-ASCII text.
          if (origin != "kcm" || cmt == "Added by kcm" || cmt ~ /^(Imported by kcm|\t496D706F72746564206279206B636D)/) cmt = ""
          if (ENVIRON["KCM_LABEL"] == "") print origin " " svc (cmt == "" ? "" : "\t" cmt)
          else if (svc == ENVIRON["KCM_LABEL"]) {
            if (origin == "kcm") rank = 3
            else if (origin == "legacy") rank = 2
            else if (crtr == "<NULL>" && desc == "<NULL>") rank = 1
            else rank = 0
            # Refuse attributes that cannot be passed back to security verbatim.
            if (!plain_acct || acct == "" || acct ~ /[[:cntrl:]]/ || ENVIRON["KCM_CHAIN"] ~ /[[:cntrl:]]/) acct = ""
            print rank "\t=" acct "\t" ENVIRON["KCM_CHAIN"]
          }
        }
        genp = 0; svc = ""; crtr = ""; desc = ""; acct = ""; plain_acct = 0; cmt = ""
      }
      /^keychain:/ { flush(); next }
      /^class:/ { genp = ($0 ~ /"genp"/); next }
      /^ *"svce"<blob>=/ { svc = val($0); next }
      /^ *"crtr"<uint32>=/ { crtr = val($0); next }
      /^ *"desc"<blob>=/ { desc = val($0); next }
      /^ *"icmt"<blob>=/ {
        cmt = val($0)
        if (cmt == "<NULL>") cmt = ""
        else if ($0 ~ /=0x[0-9A-F]+ /) { sub(/ .*/, "", cmt); cmt = "\t" substr(cmt, 3) }
        next
      }
      /^ *"acct"<blob>=/ { plain_acct = ($0 ~ /=".*"$/); acct = val($0); next }
      END { flush() }
    ' || return 1
  done <<< "$keychains"
}

# Function to list secrets matching pattern
list_secrets() {
  if ! command -v security >/dev/null 2>&1; then
    error_exit "This command requires macOS with the 'security' command"
  fi

  local pattern="${1:-*}"

  # Convert simple wildcards to regex pattern
  local grep_pattern
  if [ "$pattern" = "*" ]; then
    grep_pattern=".*"
  else
    grep_pattern=$(echo "$pattern" | sed 's/\*/.*/g' | sed 's/\?/./g')
    grep_pattern="^${grep_pattern}$"
  fi

  echo -e "${_KCM_BLUE}kcm secrets in Keychain matching '$pattern':${_KCM_NC}"
  echo ""

  # Other apps' entries are left out
  local -a ours=() legacy=()
  local origin service services hint width=0
  local -a hints=()
  # One line per service; on a name clash kcm sorts before legacy and other, so it wins.
  # Captured first: < <(...) would hide a keychain that failed to dump.
  services=$(keychain_services "$grep_pattern" | LC_ALL=C sort -k2,2 -k1,1 | awk '!seen[$2]++') \
    || error_exit "Could not read every keychain in the search list"
  while IFS=' ' read -r origin service; do
    hint=""
    if [[ "$service" == *$'\t'* ]]; then
      hint="${service#*$'\t'}"
      service="${service%%$'\t'*}"
      # A second tab marks hex, which security prints for non-ASCII text
      if [[ "$hint" == $'\t'* ]]; then hint=$(xxd -r -p <<< "${hint#$'\t'}"); fi
      if [ ${#service} -gt "$width" ]; then width=${#service}; fi
    fi
    case "$origin" in
      # Control characters become spaces, so an escape code in a hint never reaches the terminal
      kcm) ours+=("$service"); hints+=("${hint//[[:cntrl:]]/ }") ;;
      legacy) legacy+=("$service") ;;
    esac
  done <<< "$services"

  if [ ${#ours[@]} -eq 0 ] && [ ${#legacy[@]} -eq 0 ]; then
    echo "  No secrets found matching pattern '$pattern'"
    return 0
  fi
  local i
  for i in ${ours[@]+"${!ours[@]}"}; do
    if [ -n "${hints[$i]}" ]; then
      printf '  • %-*s  %b%s%b\n' "$width" "${ours[$i]}" "$_KCM_GREY" "${hints[$i]}" "$_KCM_NC"
    else
      echo "  • ${ours[$i]}"
    fi
  done
  if [ ${#legacy[@]} -gt 0 ]; then
    [ ${#ours[@]} -gt 0 ] && echo ""
    echo -e "${_KCM_GREY}Probably added by an older kcm (not tagged as kcm's):${_KCM_NC}"
    for service in "${legacy[@]}"; do
      echo "  • $service"
    done
  fi
  echo ""
  info "Use '$_KCM_SCRIPT_NAME show KEY_NAME' to view a secret"
  info "Use '$_KCM_SCRIPT_NAME copy KEY_NAME' to copy to clipboard"
  if [ ${#legacy[@]} -gt 0 ]; then
    info "To tag an older entry as kcm's: $_KCM_SCRIPT_NAME show KEY_NAME | $_KCM_SCRIPT_NAME add KEY_NAME -"
  fi
}

# Colour help text for a terminal: commands as dark chips on light grey (fixed 256
# colours, so no theme can wash them out), flags green, arguments cyan, comments grey.
# Piped help stays plain so scripts (and show_command_help) can parse it.
colorize_help() {
  if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then
    cat
    return
  fi
  awk -v B=$'\033[1m' -v C=$'\033[1;38;5;234;48;5;250m' -v F=$'\033[32m' -v A=$'\033[36m' -v D=$'\033[90m' -v N=$'\033[0m' '
    # Placeholders ([PATH], <command>, FILE) in cyan, flags (-e, --env-file, --) in green
    function args(s) {
      gsub(/[<[][A-Za-z][A-Za-z_.]*[]>]/, A "&" N, s)
      gsub(/--?[a-z][a-z-]*/, F "&" N, s)
      gsub(/ -- /, " " F "--" N " ", s)
      gsub(/\[-- /, "[" F "--" N " ", s)
      # Whole words only, so the OS in macOS stays plain
      gsub(/(^| )[A-Z][A-Z_]+/, A "&" N, s)
      return s
    }
    # Help for one command (kcm add -h) has no COMMANDS: heading
    NR == 1 && !/^kcm - / { section = "COMMANDS:" }
    /^kcm - / { print B $0 N; next }
    /^[A-Z][A-Z ]*:$/ { section = $0; print B $0 N; next }
    # Command headings: "  add KEY_NAME"; text after " - " is a description
    /^  [a-z]/ {
      match($0, /^  [^ ]+/)
      rest = substr($0, RLENGTH + 1); desc = ""
      if (i = index(rest, " - ")) { desc = substr(rest, i); rest = substr(rest, 1, i - 1) }
      name = substr($0, 3, RLENGTH - 2)
      # Only commands get a chip; its padding uses one leading space so the name keeps its column
      if (section == "COMMANDS:") print " " C " " name " " N args(rest) desc
      else print "  " B name N args(rest) desc
      next
    }
    # Option lines: "      -e, --env-file FILE   - Use only this env file"
    /^      [-A-Z]/ && index($0, " - ") {
      i = index($0, " - ")
      print args(substr($0, 1, i)) substr($0, i + 1)
      next
    }
    # Example comments
    /^      [a-z].*  # / {
      i = index($0, "  # ")
      print substr($0, 1, i + 1) D substr($0, i + 2) N
      next
    }
    { print }
  '
}

# Print one command's section of show_help (headings are the 2-space indented lines)
show_command_help() {
  show_help | awk -v cmd="$1" '/^[^ ]/ { p = 0 } /^  [a-z]/ { p = ($1 == cmd) } p'
}

# Command aliases
case "${1:-}" in
  rm) set -- remove "${@:2}" ;;
  list) set -- ls "${@:2}" ;;
esac

# `kcm <command> --help` shows that command's help instead of running it
case "${2:-}" in
  -h|--help)
    # Commands with no help section fall through to the dispatcher
    cmd_help=$(show_command_help "$1")
    if [ -n "$cmd_help" ]; then echo "$cmd_help" | colorize_help; exit 0; fi
    ;;
esac

# Main command dispatcher
case "${1:-}" in
  add)
    shift
    add_secret "$@"
    ;;
  remove)
    shift
    remove_secret "$@"
    ;;
  show)
    shift
    show_secret "$@"
    ;;
  copy)
    shift
    copy_secret "$@"
    ;;
  ls)
    shift
    list_secrets "$@"
    ;;
  use)
    shift
    use_secrets "$@"
    ;;
  install-wrapper)
    shift
    install_wrapper "$@"
    ;;
  import)
    shift
    import_secrets "$@"
    ;;
  export)
    shift
    export_secrets "$@"
    ;;
  version|--version|-v)
    echo "kcm version $_KCM_VERSION"
    ;;
  help|--help|-h)
    show_help | colorize_help
    ;;
  "")
    show_help | colorize_help
    exit 1
    ;;
  *)
    echo -e "${_KCM_RED}Error: Unknown command '$1'${_KCM_NC}" >&2
    echo "" >&2
    echo "Available commands: add, remove, show, copy, ls, use, import, export, install-wrapper, version, help" >&2
    echo "Try '$_KCM_SCRIPT_NAME help' for more information." >&2
    exit 1
    ;;
esac
